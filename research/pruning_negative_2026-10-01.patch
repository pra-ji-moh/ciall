+static const unsigned char (*CLOCK)[PL_SIZE];   /* cells that tick by themselves, or none */
+
+void ru_clock(const unsigned char (*mask)[PL_SIZE]) {
+  CLOCK = mask;
+}
+
+/* is this thing the clock's: made of ticking cells, or lying against them? */
+static int clock_thing(const ru_thing_t *t, const pl_frame_t *f) {
+  unsigned r, c;
+  if (CLOCK == 0) return 0;
+  for (r = t->top; r <= t->bottom; r++) {
+    for (c = t->left; c <= t->right; c++) {
+      if (f->c[r][c] != t->colour) continue;
+      if (CLOCK[r][c]) return 1;
+      if (r > 0u && CLOCK[r - 1u][c]) return 1;
+      if (c > 0u && CLOCK[r][c - 1u]) return 1;
+      if (r + 1u < f->h && CLOCK[r + 1u][c]) return 1;
+      if (c + 1u < f->w && CLOCK[r][c + 1u]) return 1;
+    }
+  }
+  return 0;
+}
